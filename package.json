{
  "name": "formulate-landing",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "sync": "bash scripts/sync-catalog.sh",
    "typecheck": "node -e \"require('fs').rmSync('.next/dev/types',{recursive:true,force:true})\" && next typegen && tsc --noEmit",
    "verify": "npm run --silent typecheck && node scripts/i18n-check.mjs && node scripts/translate-captions.mjs --check",
    "verify:i18n": "node scripts/i18n-check.mjs",
    "verify:captions": "node scripts/translate-captions.mjs --check",
    "captions": "node scripts/translate-captions.mjs",
    "install-hooks": "git config core.hooksPath scripts/git-hooks",
    "lint:gate": "node scripts/lint-gate.mjs",
    "lint:baseline": "node scripts/lint-gate.mjs --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdroppar/formulate-landing.git"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "motion": "^12.40.0",
    "next": "^16.1.6",
    "posthog-js": "^1.378.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
