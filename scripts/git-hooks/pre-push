#!/bin/sh
# formulate-landing self-verification gate.
# Install in a fresh clone or worktree:  npm run install-hooks
# Emergency bypass:                      git push --no-verify
#
# Before 2026-08-18 this repo had no gate of any kind: core.hooksPath was unset,
# there was no typecheck script, and `npm run lint` ran `next lint`, which Next 16
# removed -- it errored and nothing invoked it. Mirrors formulate-web's gate.
#
# The "[pre-push]" marker below is load-bearing. `git hook run pre-push | grep 'pre-push'`
# matches git's OWN error text ("cannot find a hook named pre-push") and reports success
# when no hook exists. Always grep for the bracketed form.

# git sends "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
PUSHING_TO_DEPLOY=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$local_sha" in
    "" | 0000000000000000000000000000000000000000) continue ;;
  esac
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) PUSHING_TO_DEPLOY=1 ;;
  esac
done

echo "[pre-push] typecheck: next typegen && tsc --noEmit"
if ! npm run --silent typecheck; then
  echo ""
  echo "[pre-push] x typecheck failed - push blocked."
  echo "           Fix the type errors, or bypass with: git push --no-verify"
  exit 1
fi
echo "[pre-push] v typecheck passed"

echo "[pre-push] lint ratchet: scripts/lint-gate.mjs"
if ! npm run --silent lint:gate; then
  echo ""
  echo "[pre-push] x lint ratchet failed - push blocked."
  exit 1
fi

# Build gate, deploy branch only. Vercel auto-deploys this site, and tsc/lint both pass
# on the prerender-only failure classes. Scoped so wip pushes stay fast: a gate people
# routinely bypass with --no-verify is worse than no gate.
if [ "$PUSHING_TO_DEPLOY" = "1" ]; then
  echo "[pre-push] deploy branch detected - npm run build (this is the slow one)"
  if ! npm run --silent build; then
    echo ""
    echo "[pre-push] x build failed - push blocked."
    exit 1
  fi
  echo "[pre-push] v build passed"
fi

# ── cross-client data parity ─────────────────────────────────────────────────
#
# The landing MIRRORS web's catalogs — it does not export its own. Nothing
# enforced that, and on 2026-09-03 the three clients were serving three
# different catalogs. Web's push is gated the same way; drift can start here
# just as easily, so the enforcement has to be symmetric or it just moves.
#
# --local landing compares THIS TREE (the commit is not on origin yet) against
# what web and mobile actually ship. Byte differences are not drift: the tool
# compares parsed content with int/float representation normalised, so autocrlf
# and this repo's own ?v= image-token rewriting stay quiet.
if [ "$PUSHING_TO_DEPLOY" = "1" ]; then
  MAIN_REPO="$(cd "$(git rev-parse --git-common-dir)/.." 2>/dev/null && pwd)"
  PARITY_TOOL="$MAIN_REPO/../Formulate/tools/client_data_parity_check.py"
  [ -f "$PARITY_TOOL" ] || PARITY_TOOL="../Formulate/tools/client_data_parity_check.py"
  if [ ! -f "$PARITY_TOOL" ]; then
    # Never skip quietly — an absent checker and a passing one look identical.
    echo "[pre-push] ! cross-client parity SKIPPED — checker not found."
    echo "           Looked for: $PARITY_TOOL"
    echo "           This push is NOT verified against web/mobile."
  else
    echo "[pre-push] cross-client data parity (this tree vs web/mobile shipping refs)"
    LAND_TREE="$(git rev-parse --show-toplevel)"
    if ! python "$PARITY_TOOL" --local landing --repo "landing=$LAND_TREE" --strict; then
      echo ""
      echo "[pre-push] x cross-client data drift - push blocked."
      echo "           A catalog here disagrees with what web or mobile SHIP."
      echo "           The landing mirrors web; re-sync from web rather than"
      echo "           editing here, then push."
      echo "           Emergency bypass: git push --no-verify"
      exit 1
    fi
    echo "[pre-push] v clients agree"
  fi
fi

exit 0
